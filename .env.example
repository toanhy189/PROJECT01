GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSION=768
GEMINI_TIMEOUT_MS=30000
ARTIFACT_DIR=artifacts
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=diabetes_knowledge
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RETRIEVAL_K=5
MAX_COSINE_DISTANCE=0.65
CONTEXT_MAX_CHARS=14000
RETRIEVAL_INDEX_DIR=data/retrieval
# Các nhánh thử nghiệm đã triển khai; giữ tắt cho đến khi đạt kiểm định chất lượng.
ENABLE_GRAPH_RETRIEVAL=false
ENABLE_HYBRID_SEARCH=false
ENABLE_WIKI=false
ENABLE_RERANKING=false
RETRIEVAL_CANDIDATE_K=15
GRAPH_MAX_HOPS=2
GRAPH_MAX_PATHS=40
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_BEFORE_START
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=7687
NEO4J_CONNECTION_TIMEOUT_SECONDS=2
NEO4J_QUERY_TIMEOUT_SECONDS=2
NEO4J_POOL_SIZE=4
GRAPH_EXPANSION_LIMIT=400
RRF_CONSTANT=60
FUSION_POLICY=vector_guarded
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TIMEOUT_SECONDS=15
RERANKER_MAX_CANDIDATES=15
WIKI_USER_AGENT="GlucoGuideAcademicRAG/0.1 (local student project)"
